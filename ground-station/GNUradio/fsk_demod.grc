    bus_source: false
    bus_structure: null
    coordinate: [576, 1080.0]
    rotation: 0
    state: enabled
- name: iq_file
  id: variable
  parameters:
    comment: "A new file each time Record IQ is ticked, named by its UTC start time"
    value: "os.path.join(logs, time.strftime('%Y%m%dT%H%M%SZ', time.gmtime()) + '.iq') if record_iq else os.devnull"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [752, 1080.0]
    rotation: 0
    state: enabled
